# Secrets for the Streamlit Video Processing App
# Copy this file to .streamlit/secrets.toml and fill in your credentials.
# Note: .streamlit/secrets.toml is gitignored and will not be committed.

# MinIO Configuration
[minio]
endpoint = "localhost:9000"
access_key = "minioadmin"
secret_key = "minioadmin"
bucket_name = "videos"
transcripts_bucket_name = "transcripts"
secure = false

# MongoDB Configuration
[mongodb]
uri = "mongodb://localhost:27017/"
database_name = "video_metadata_db"
collection_name = "videos"

# Pinecone Configuration
# Create 4 indexes with dimension 1024, metric "cosine":
# - video-search
# - audio-search
# - text-search
# - desc-search
[pinecone]
api_key = "YOUR_PINECONE_API_KEY"
video_index_name = "video-search"
audio_index_name = "audio-search"
text_index_name = "text-search"
desc_index_name = "desc-search"

# OpenAI Configuration (Optional but recommended for translation and analysis)
[openai]
api_key = "YOUR_OPENAI_API_KEY"

